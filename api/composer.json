{
    "name": "euskalduo/api",
    "description": "EUSKALDUO content and admin API",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-pdo_sqlite": "*",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^8.1"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "symfony/runtime": true }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests bin public -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
    }
}
