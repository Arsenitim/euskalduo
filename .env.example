# Copy to .env and adjust. Never commit .env.

# Where the site is published on the host. Default: localhost only.
EUSKALDUO_BIND=127.0.0.1
# IPv6 address to publish on (in brackets). Use [::] together with
# EUSKALDUO_BIND=0.0.0.0 to reach the app on a home network via name.local.
EUSKALDUO_BIND6=[::1]
EUSKALDUO_PORT=8765

# Admin login. If both password variables are empty, a random password is
# generated on first start and printed once in `docker compose logs api`.
ADMIN_USERNAME=admin
# Plain password (min. 12 characters recommended) ...
ADMIN_PASSWORD=
# ... or a bcrypt/argon2 hash instead (escape every "$" as "$$" in this file):
#   docker compose run --rm api php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), "\n";'
ADMIN_PASSWORD_HASH=

# Symfony secret. Leave empty to generate one in the data volume on first start.
APP_SECRET=

# Load the two sample homework sets into an empty database on first start.
SEED_SAMPLE_CONTENT=true
